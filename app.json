{
  "expo": {
    "name": "FitTrack Local",
    "slug": "fittrack-local",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fittrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#121212",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrack.local",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permite escolher fotos de progresso da galeria.",
        "NSCameraUsageDescription": "Permite tirar fotos de progresso.",
        "NSPhotoLibraryAddUsageDescription": "Permite guardar fotos de progresso na galeria."
      }
    },
    "android": {
      "package": "com.fittrack.local",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack precisa de acesso às fotos para escolher imagens de progresso.",
          "cameraPermission": "FitTrack precisa da câmara para tirar fotos de progresso."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
